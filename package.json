{
  "name": "marchlands",
  "version": "0.2.2",
  "private": true,
  "description": "3D 领地争夺游戏，Three.js 客户端与确定性 TypeScript 模拟核心",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HuoGu-Hub/Marchlands.git"
  },
  "homepage": "https://github.com/HuoGu-Hub/Marchlands#readme",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "sim:forest01": "pnpm --filter @marchlands/harness start -- --matches 100",
    "validate:content": "pnpm --filter @marchlands/content validate",
    "build:forest01": "pnpm --filter @marchlands/map-export build:forest01",
    "build:crossroads01": "pnpm --filter @marchlands/map-export build:crossroads01",
    "dev": "pnpm --filter @marchlands/client dev",
    "package:win": "pnpm --filter @marchlands/client package:win",
    "test:e2e": "playwright test",
    "previews": "node tools/previews/capture-previews.mjs",
    "portraits": "node tools/portraits/capture-portraits.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "playwright": "^1.64.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}